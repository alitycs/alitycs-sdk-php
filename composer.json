{
    "name": "alitycs/alitycs-sdk-php",
    "description": "Alitycs Analytics SDK for PHP — server-side event tracking with batching, sessions, and retry.",
    "type": "library",
    "version": "1.0.0",
    "keywords": ["alitycs", "analytics", "events", "tracking"],
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Alitycs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alitycs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": "@php bin/coverage-gate.php",
        "conformance": "@php ../conformance/apps/php/main.php"
    },
    "config": {
        "sort-packages": true
    }
}
